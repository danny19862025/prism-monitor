#!/bin/sh
# Start a game with FPS reporting for Prism Monitor (Linux).
# Steam: right-click game > Properties > Launch options:  prism-monitor-run %command%
# Set PRISM_MONITOR_HUD=1 to also keep MangoHud's own on-screen HUD.
set -eu
dir="${XDG_STATE_HOME:-$HOME/.local/state}/prism-monitor/mangohud"
mkdir -p "$dir"
extra="output_folder=$dir,autostart_log=1,log_interval=250"
[ "${PRISM_MONITOR_HUD:-0}" = 1 ] || extra="$extra,no_display"
export MANGOHUD_CONFIG="${MANGOHUD_CONFIG:+$MANGOHUD_CONFIG,}$extra"
export MANGOHUD=1
if command -v mangohud >/dev/null 2>&1; then
    exec mangohud "$@"
fi
echo "prism-monitor-run: MangoHud is not installed, so no FPS will be reported." >&2
exec "$@"
